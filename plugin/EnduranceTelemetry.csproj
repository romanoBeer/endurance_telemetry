<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Endurance Telemetry — SimHub plugin.

    Build (on the rig, Windows + SimHub installed):
        msbuild EnduranceTelemetry.csproj /p:Configuration=Release
    or open the .sln in Visual Studio.

    SimHubDir must point at your SimHub install (the folder with SimHubWPF.exe).
    Override on the command line if it isn't the default:
        msbuild /p:SimHubDir="C:\Program Files (x86)\SimHub"

    On build, the DLL is copied into the SimHub folder so SimHub picks it up on
    next launch (set CopyToSimHub=false to skip).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>EnduranceTelemetry</AssemblyName>
    <RootNamespace>EnduranceTelemetry</RootNamespace>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
    <CopyToSimHub Condition="'$(CopyToSimHub)' == ''">true</CopyToSimHub>
  </PropertyGroup>

  <!-- SimHub ships every reference we need; point at the install, don't NuGet them. -->
  <ItemGroup>
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubDir)\GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ACSharedMemory">
      <HintPath>$(SimHubDir)\ACSharedMemory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>$(SimHubDir)\SimHub.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubDir)\log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SimHubDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <!-- Ship the phone control page next to the DLL. -->
  <ItemGroup>
    <None Include="web\control.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToSimHub" AfterTargets="Build" Condition="'$(CopyToSimHub)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SimHubDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(OutputPath)web\control.html" DestinationFolder="$(SimHubDir)\PluginsData\EnduranceTelemetry" SkipUnchangedFiles="false" />
  </Target>

</Project>
